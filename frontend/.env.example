# ============================================
# ServeNep Frontend - Environment Configuration
# ============================================
# Copy this file to .env.local for local development.
# On Vercel, set NEXT_PUBLIC_API_URL as a Project Environment Variable instead
# (it must be present at BUILD time — Next.js inlines NEXT_PUBLIC_* vars into
# the client bundle, so setting it only at runtime has no effect).
# ============================================

NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1
