# ============================================
# ServeNep Backend - Environment Configuration
# ============================================
# Copy this file to .env and fill in values
# NEVER commit .env to version control!
# ============================================

# Application
NODE_ENV=development
PORT=5000

# CORS
CORS_ORIGIN=http://localhost:3000

# Database - PostgreSQL
# For local dev, use the discrete fields below.
# For a managed host (Neon, Render, Railway, ...), set DATABASE_URL instead —
# when present it takes priority over the discrete fields below.
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=your_strong_password_here
DATABASE_NAME=servenep

# Schema sync — no migration system exists yet, so TypeORM creates/updates
# tables to match the entities on every boot by default (true). Set to
# "false" once the schema is stable and you don't want live alterations.
DB_SYNCHRONIZE=true

# JWT Authentication
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-super-strong-jwt-secret-at-least-64-chars-long
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# eSewa Payment Gateway (Sandbox defaults shown)
ESEWA_MERCHANT_CODE=EPAYTEST
ESEWA_SECRET_KEY=your-esewa-secret-key
ESEWA_URL=https://uat.esewa.com.np/api/epay/main/v2/form

# Khalti Payment Gateway (Sandbox defaults shown)
KHALTI_SECRET_KEY=your-khalti-secret-key
KHALTI_URL=https://a.khalti.com/api/v2/epayment/initiate/

# SMS Gateway (Aakash SMS)
AAKASH_SMS_TOKEN=your-aakash-sms-token