# ============================================
# ServeNep Backend - Environment Configuration
# ============================================
# Copy this file to .env and fill in values
# NEVER commit .env to version control!
# ============================================

# Application
NODE_ENV=development
PORT=5000

# CORS
CORS_ORIGIN=http://localhost:3000

# Used to build payment gateway redirect URLs (eSewa success_url, Khalti
# return_url) — must be the real deployed frontend origin in production.
FRONTEND_URL=http://localhost:3000

# Database - PostgreSQL
# For local dev, use the discrete fields below.
# For a managed host (Neon, Render, Railway, ...), set DATABASE_URL instead —
# when present it takes priority over the discrete fields below.
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=your_strong_password_here
DATABASE_NAME=servenep

# Schema sync — no migration system exists yet, so TypeORM creates/updates
# tables to match the entities on every boot by default (true). Set to
# "false" once the schema is stable and you don't want live alterations.
DB_SYNCHRONIZE=true

# Set to "true" only on a production deploy that is itself a public demo
# (no real users, no real SMS gateway) — re-enables the one-click demo
# login and visible OTP that are otherwise hardcoded off in production.
DEMO_MODE=false

# JWT Authentication
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-super-strong-jwt-secret-at-least-64-chars-long
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Real payments (no merchant API) — eSewa/Khalti transfers sent manually by
# customers to this number are claimed in-app and confirmed by an admin.
# See PaymentsService.claimManualPayment / verifyManualPayment.
# The number itself is a frontend constant (MANUAL_PAYMENT_NUMBER in
# booking/page.tsx and the customer dashboard), not an env var.

# eSewa sandbox integration (technical demo only — moves test money, not
# real money). EPAYTEST / the secret key below are eSewa's own published
# shared UAT test credentials — safe defaults, not a real merchant secret.
ESEWA_MERCHANT_CODE=EPAYTEST
ESEWA_SECRET_KEY=8gBm/:&EnhH.1/q
ESEWA_URL=https://rc-epay.esewa.com.np/api/epay/main/v2/form
ESEWA_STATUS_URL=https://rc.esewa.com.np/api/epay/transaction/status/

# Khalti sandbox integration (technical demo only). Unlike eSewa, Khalti has
# no shared public test key — sign up at https://test-admin.khalti.com for
# your own free test secret key. Leave unset to disable Khalti sandbox
# checkout (the manual pay-to-number flow still works without it).
KHALTI_SECRET_KEY=
KHALTI_BASE_URL=https://dev.khalti.com/api/v2

# SMS Gateway (Aakash SMS)
AAKASH_SMS_TOKEN=your-aakash-sms-token